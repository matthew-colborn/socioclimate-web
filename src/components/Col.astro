---
import { MAILTO } from '../config/site';
interface Props {
  kicker: string;
  title: string;
  cta?: string;
  mail?: 'partner' | 'acquire' | 'plain';
}
const { kicker, title, cta, mail } = Astro.props;
---
<div class="col">
  <p class="col__kicker">{kicker}</p>
  <h2 class="col__title">{title}</h2>
  <div class="col__body"><slot /></div>
  {cta && mail && (
    <a class="btn btn--solid" href={MAILTO[mail]}>
      {cta}<span class="btn__arrow" aria-hidden="true">→</span>
    </a>
  )}
</div>

<style>
  .col { min-width: 0; }
  .col__kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-dim);
    margin: 0 0 var(--s-2);
  }
  /* Inside a column the h2 keeps its size but loses the .prose top rule. */
  .col__title {
    font-size: var(--step-2);
    margin: 0 0 var(--s-3);
    padding-top: 0;
    border-top: 0;
  }
  .col__body :global(h3) {
    font-size: var(--step-0);
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--paper-dim);
    margin-top: var(--s-5);
  }
  .col__body :global(h3 + p),
  .col__body :global(h3 + ul) { margin-top: var(--s-2); }
  .col__body :global(> *:first-child) { margin-top: 0; }
  .col__body :global(p:last-child) { margin-bottom: var(--s-4); }
</style>
