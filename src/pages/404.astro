---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/sc/SectionHead.astro';

const d = (await getEntry('pages', 'contact'))!.data;
const nf = d.sections.find((s) => s.key === 'notfound')!;
---
<BaseLayout title="Not found · SocioClimate" description={nf.lead!}>
  <section class="sc-section sc-hero sc-hero--short">
    <div class="wrap">
      <SectionHead as="h1" label="404" title={nf.title} lead={nf.lead} />
      <a class="cta" href="/databases">{nf.link}<span class="cta__arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
