---
import { getEntry } from 'astro:content';
import Diagnostic from '../Diagnostic.astro';
import Field from '../Field.astro';
import '../../styles/diagnostic.css';

const d = (await getEntry('pages', 'contact'))!.data;
---
<section id="03-contact" class="site-section" tabindex="-1" aria-labelledby="s03-h">
  <span id="s03-h" class="visually-hidden">Contact</span>

  <header class="ch wrap">
    <div class="ch__copy">
      <p class="eyebrow"><span class="ch__n">{d.section}</span> Contact</p>
      <h2 class="section-h">{d.heading}</h2>
      <p class="ch__lede">{d.standfirst}</p>
    </div>
    {/* A way through rather than an object to look at, which is what a contact
        section is. The flame stays at the top of the page: a mark loses its
        weight when it appears twice. */}
    <div class="ch__field"><Field scene="threshold" variant="panel" /></div>
  </header>

  <Diagnostic />
</section>

<style>
.ch {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.55fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: var(--s-6);
  }
  .ch__n { color: var(--cyan); margin-right: 0.5em; }
  .ch__field { justify-self: center; width: 100%; max-width: 20rem; }
  .ch__field :global(.field) {
    border: 1px solid color-mix(in srgb, var(--teal-shadow) 80%, transparent);
    border-radius: var(--radius);
    background: var(--ink-deep);
  }
  .ch h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); max-width: 14ch; }
  .ch__lede { color: var(--paper-dim); font-size: var(--step-1); margin: var(--s-4) 0 0; max-width: 44ch; }

  @media (max-width: 60rem) {
    .ch { grid-template-columns: 1fr; }
    .ch__field { max-width: 16rem; justify-self: start; }
  }
</style>
