---
import Wordmark from './Wordmark.astro';
import { SITE, MAILTO, NAV } from '../config/site';
const year = 2026;
---
<footer class="site-foot">
  <div class="wrap site-foot__inner">
    <div>
      <Wordmark size="md" />
      <p class="site-foot__say">{SITE.mission}</p>
    </div>
    <nav aria-label="Footer">
      <h2 class="site-foot__h">Site</h2>
      <ul>
        {NAV.map((i) => (
          <li><a href={i.href}><span class="site-foot__n" aria-hidden="true">{i.n}</span>{i.label}</a></li>
        ))}
      </ul>
    </nav>
    <div>
      <h2 class="site-foot__h">Start</h2>
      <ul>
        <li><a href="#03-contact">Run the diagnostic</a></li>
        <li><a href={MAILTO}>{SITE.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap site-foot__legal">
    <p>© {year} {SITE.legalName}. San Diego, California.</p>
    <p>{SITE.compressed}</p>
  </div>
</footer>

<style>
  /* The footer number sits with the label rather than in its own column: at
     this size a second column would be alignment for its own sake. */
  .site-foot__n {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    /* Full --paper-dim: mixing it toward transparent drops it under AA, and the
       token-pair contrast check cannot see a color-mix. */
    color: var(--paper-dim);
    margin-right: 0.6em;
  }
</style>
