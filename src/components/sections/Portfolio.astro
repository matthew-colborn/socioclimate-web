---
import { getCollection, getEntry, render } from 'astro:content';
import Field from '../Field.astro';
import { clientName, type ClientKey } from '../../config/site';

const page = await getEntry('pages', 'portfolio');
if (!page) throw new Error('Missing src/content/pages/portfolio.mdx');
const { Content: Intro } = await render(page);
const d = page.data;

const entries = await Promise.all(
  (await getCollection('portfolio'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (e) => ({
      id: e.id,
      data: e.data,
      display: clientName(e.data.clientKey as ClientKey, { cap: true }) ?? e.data.name,
      Body: (await render(e)).Content,
    }))
);
---
<section id="02-portfolio" class="site-section" tabindex="-1" aria-labelledby="s02-h">
  <span id="s02-h" class="visually-hidden">Portfolio</span>

  <header class="page-head wrap">
    <p class="eyebrow"><span class="page-head__n">{d.section}</span> Portfolio</p>
    <h2 class="section-h">{d.heading}</h2>
    <p class="page-head__lede">{d.standfirst}</p>
  </header>

  <section class="intro wrap" data-reveal>
    <div class="prose"><Intro /></div>
  </section>

  <div class="wrap">
    {entries.map((e) => (
      <article class="entry" data-reveal id={e.id}>
        <div class="entry__top">
          <div class="entry__figure"><Field scene={e.data.scene} variant="panel" /></div>
          <div class="entry__head">
            <p class="entry__meta"><span class="entry__stage">{e.data.stage}</span></p>
            <h3 class="entry__name">{e.display}</h3>
            <p class="entry__headline">{e.data.headline}</p>
          </div>
        </div>

        <dl class="entry__facts">
          <div>
            <dt>The business</dt>
            <dd>{e.data.business}</dd>
          </div>
          <div>
            <dt>The leverage found</dt>
            <dd>{e.data.leverage}</dd>
          </div>
          <div>
            <dt>What it produced</dt>
            <dd>{e.data.produced}</dd>
          </div>
        </dl>

        {e.data.readouts.length > 0 && (
          <ul class="entry__readouts">
            {e.data.readouts.map((r) => (
              <li class:list={['readout', r.pending && 'readout--pending']}>
                <span class="readout__label">{r.label}</span>
                <span class="readout__value">{r.value}</span>
                {r.note && <span class="readout__note">{r.note}</span>}
              </li>
            ))}
          </ul>
        )}

        <div class="entry__body prose"><e.Body /></div>
      </article>
    ))}
  </div>

  <section class="tail wrap" data-reveal>
    <p class="eyebrow">Next</p>
    <h2 class="tail__h">Find out whether you have one.</h2>
    <p class="tail__p">Five questions, scored as you answer, nothing gated.</p>
    <a class="cta" href="#03-contact">Run the diagnostic<span class="cta__arrow" aria-hidden="true">↗</span></a>
  </section>
</section>

<style>
.page-head__n { color: var(--cyan); margin-right: 0.5em; }
  .intro { padding-bottom: var(--s-7); }

  .entry {
    border-top: 1px solid color-mix(in srgb, var(--teal-deep) 80%, transparent);
    padding-top: var(--s-5);
    margin-bottom: var(--s-8);
  }
  /* The scene sits beside the name rather than above it. Every object here is
     derived from the flame contour and is therefore tall and narrow; given a
     full-width band it ends up as a small bright thing marooned in the middle
     of a dark one. A square panel beside the text suits the shape and lets the
     name and the mark introduce the entry together. */
  .entry__top {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: var(--s-5);
    align-items: center;
    margin-bottom: var(--s-5);
  }
  .entry__figure :global(.field) {
    border: 1px solid color-mix(in srgb, var(--teal-shadow) 80%, transparent);
    border-radius: var(--radius);
    background: var(--ink-deep);
  }
  @media (max-width: 52rem) {
    .entry__top { grid-template-columns: 1fr; gap: var(--s-4); }
    .entry__figure { max-width: 20rem; }
  }

  .entry__head { margin-bottom: 0; }
  .entry__meta { margin: 0 0 var(--s-3); }
  .entry__stage {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
    border: 1px solid color-mix(in srgb, var(--cyan) 40%, transparent);
    border-radius: 999px;
    padding: 0.24em 0.75em;
  }
  .entry__name { font-size: clamp(1.7rem, 3.8vw, 2.5rem); margin-bottom: var(--s-2); }
  .entry__headline {
    font-size: var(--step-1);
    font-weight: 300;
    color: var(--paper-dim);
    margin: 0;
    max-width: 40ch;
  }

  .entry__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--s-4);
    margin: 0 0 var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid color-mix(in srgb, var(--teal-shadow) 80%, transparent);
  }
  .entry__facts dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-dim);
    margin-bottom: 0.6em;
  }
  .entry__facts dd { margin: 0; font-size: 0.92rem; color: var(--paper); line-height: 1.55; }

  .entry__readouts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    list-style: none;
    margin: 0 0 var(--s-5);
    padding: var(--s-4) 0;
    border-top: 1px solid color-mix(in srgb, var(--teal-shadow) 80%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--teal-shadow) 80%, transparent);
  }

  .entry__body { max-width: 62ch; }

  .tail {
    border-top: 1px solid color-mix(in srgb, var(--teal-deep) 80%, transparent);
    padding-block: clamp(3rem, 8vh, 5rem) var(--s-8);
  }
  .tail__h { font-size: clamp(1.8rem, 4vw, 2.6rem); max-width: 18ch; }
  .tail__p { color: var(--paper-dim); margin: var(--s-3) 0 var(--s-5); }
</style>
