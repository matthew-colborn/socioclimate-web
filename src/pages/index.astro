---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Field from '../components/Field.astro';
import { SITE } from '../config/site';
import POSTERS from '../data/posters.json';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing src/content/pages/home.mdx');
const { Content } = await render(page);
const d = page.data;

const moves = (await getCollection('process')).sort((a, b) => a.data.order - b.data.order);
const beats = d.beats ?? [];
---
<BaseLayout
  title="SocioClimate"
  description={d.description}
  organization={true}
  bleed={true}
  preloadImage={POSTERS.flame}
>
  <section
    class="hero wrap"
    data-thesis
    aria-roledescription="carousel"
    aria-label="The argument, in four beats"
  >
    <div class="hero__copy">
      {/* One heading for the document, and it does not rotate. Giving each beat
          its own h1 put four of them on the page, three aria-hidden at any
          moment, and made the page's main heading depend on when you looked. */}
      <h1 class="visually-hidden">{d.heading}</h1>

      <div class="hero__stack" data-beat-stack>
        {beats.map((b, i) => (
          <article
            class:list={['beat', i === 0 && 'is-on']}
            data-beat={b.headline}
            role="group"
            aria-roledescription="slide"
            aria-label={`Beat ${i + 1} of ${beats.length}`}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            <p class="hero__eyebrow">
              <span class="hero__n">{b.n}</span>
              <span>{i === 0 ? 'Data leverage' : 'The argument'}</span>
            </p>
            <p class="hero__h">{b.headline}</p>
            <p class="hero__line">{b.line}</p>
            {b.readouts.length > 0 && (
              <ul class="beat__readouts">
                {b.readouts.map((r) => (
                  <li class="readout">
                    <span class="readout__label">{r.label}</span>
                    <span class="beat__value">{r.value}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>

      {/* Outside the rotation on purpose. Nothing a visitor wants is behind a
          beat coming round. */}
      <div class="hero__act">
        <a class="cta" href="/what-we-do">
          How it works<span class="cta__arrow" aria-hidden="true">↗</span>
        </a>
        <div class="beat-ctl">
          <button class="beat-ctl__pause" type="button" data-beat-pause aria-pressed="false">
            <span class="beat-ctl__glyph" aria-hidden="true"></span>
            <span data-beat-pause-label>Pause</span>
            <span class="visually-hidden"> the rotation</span>
          </button>
          <ul class="beat-ctl__dots">
            {beats.map((b, i) => (
              <li>
                <button
                  type="button"
                  data-beat-goto={i}
                  aria-current={i === 0 ? 'true' : 'false'}
                  aria-label={`Show beat ${i + 1} of ${beats.length}`}
                >
                  <span aria-hidden="true">{b.n}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="hero__field"><Field scene="flame" priority={true} /></div>

    <p class="visually-hidden" data-beat-live aria-live="off" aria-atomic="true"></p>
  </section>

  <section class="band wrap" aria-labelledby="thesis-h">
    <p class="eyebrow" id="thesis-h">The thesis</p>
    <div class="prose"><Content /></div>
  </section>

  <section class="band wrap" aria-labelledby="moves-h">
    <p class="eyebrow" id="moves-h">The process</p>
    <h2 class="band__h">Four moves, in order.</h2>
    <ol class="moves">
      {moves.map((m) => (
        <li>
          <a class="panel move" href={`/what-we-do#${m.id}`}>
            <span class="move__n">{m.data.step}</span>
            <span class="move__name">{m.data.name}</span>
            <span class="move__line">{m.data.line}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="band wrap" aria-labelledby="lines-h">
    <p class="eyebrow" id="lines-h">What delivery includes</p>
    <h2 class="band__h">The mechanism is custom software.</h2>
    <p class="band__p">
      Usually all of it, because the parts only work together — an operating
      system nobody points at revenue is just tidier software, and marketing
      pointed at a business that cannot see its own record is guesswork with a
      budget.
    </p>
    <ul class="lines">
      {(d.lines ?? []).map((l) => (
        <li class="line">
          <span class="line__label">{l.label}</span>
          <span class="line__note">{l.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="tail wrap">
    <p class="eyebrow">Next</p>
    <h2 class="tail__h">{SITE.mission}</h2>
    <p class="tail__p">
      Every partnership builds another record that nobody else holds and that is
      worth more the longer it runs. The portfolio is what that has produced so
      far, labelled honestly.
    </p>
    <a class="cta" href="/portfolio">See the work<span class="cta__arrow" aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<style>
  /* --- Hero ---------------------------------------------------------------
     Two columns: the argument on the left, the mark on the right. The mark is
     one continuously running scene and never restarts between beats — what
     cycles is the text. */
  .hero {
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(7rem, 14vh, 10rem) clamp(3rem, 8vh, 6rem);
  }
  .hero__copy { position: relative; z-index: 1; }
  .hero__field { justify-self: center; width: 100%; max-width: 30rem; }

  /* Every beat occupies the same grid cell, so the stack is as tall as the
     tallest one and swapping between them shifts nothing. A fixed min-height
     would be a magic number that goes stale the moment the copy changes. */
  .hero__stack { display: grid; }
  .beat {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 520ms var(--ease), transform 520ms var(--ease),
                visibility 0s linear 520ms;
  }
  .beat.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 520ms var(--ease), transform 520ms var(--ease),
                visibility 0s;
  }

  .hero__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 0.7em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 var(--s-4);
  }
  .hero__n { color: var(--gold); }
  .hero__h {
    font-size: clamp(1.9rem, 4.2vw, 3.2rem);
    font-weight: 250;
    letter-spacing: -0.025em;
    max-width: 18ch;
  }
  .hero__line {
    font-size: clamp(0.95rem, 1.5vw, 1.08rem);
    color: var(--ink-2);
    margin: var(--s-4) 0 0;
    max-width: 46ch;
  }

  .beat__readouts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: var(--s-3) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
  }
  /* Not .readout__value: these are short qualitative claims rather than
     measurements, so they are set in the body face. Mono here would dress an
     assertion up as a reading. */
  .beat__value {
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.3;
    max-width: 18ch;
  }

  /* --- Act: the fixed CTA and the rotation controls ------------------------ */
  .hero__act {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-5);
    margin-top: var(--s-6);
  }
  .beat-ctl { display: flex; align-items: center; gap: var(--s-4); }
  .beat-ctl__pause,
  .beat-ctl__dots button {
    background: none;
    border: 0;
    padding: 0.3em 0.1em;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-2);
    cursor: pointer;
    transition: color var(--dur-1) var(--ease);
  }
  .beat-ctl__pause { display: inline-flex; align-items: center; gap: 0.5em; }
  .beat-ctl__pause:hover,
  .beat-ctl__dots button:hover { color: var(--ink); }
  .beat-ctl__glyph {
    width: 7px; height: 9px;
    border-left: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }
  .beat-ctl__pause[aria-pressed='true'] .beat-ctl__glyph {
    border: 0;
    width: 0; height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 8px solid currentColor;
  }
  .beat-ctl__dots { display: flex; gap: var(--s-3); list-style: none; margin: 0; padding: 0; }
  .beat-ctl__dots button[aria-current='true'] { color: var(--gold); }
  .beat-ctl__dots button[aria-current='true'] span {
    border-bottom: 1px solid var(--gold);
    padding-bottom: 2px;
  }

  @media (max-width: 60rem) {
    .hero {
      min-height: 0;
      display: flex;
      flex-direction: column;
      padding-block: clamp(5.5rem, 16vh, 7rem) var(--s-6);
      gap: var(--s-5);
    }
    /* The mark leads on a phone. `order` rather than column-reverse so the
       reading order stays copy-first and only the paint order changes. */
    .hero__field { order: -1; max-width: 16rem; align-self: center; }
    .hero__h { font-size: clamp(1.75rem, 6.5vw, 2.4rem); max-width: 20ch; }
    .beat__readouts { gap: var(--s-4); }
    .beat__value { font-size: 0.9rem; }
  }

  /* No crossfade when motion is not wanted. The rotator does not auto-advance
     either, so this only affects the jump when a dot is pressed. */
  @media (prefers-reduced-motion: reduce) {
    .beat { transition: none; transform: none; }
    .beat.is-on { transition: none; }
  }

  /* --- Bands --------------------------------------------------------------- */
  .band { padding-block: clamp(3rem, 8vh, 5rem); }
  .band__h {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    max-width: 24ch;
    margin-bottom: var(--s-4);
  }
  .band__p { color: var(--ink-2); max-width: 60ch; margin-bottom: var(--s-5); }

  /* --- The four moves ------------------------------------------------------ */
  .moves {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--s-3);
  }
  .move {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .move__n {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--cyan);
  }
  .move__name {
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--ink);
  }
  .move__line { font-size: 0.88rem; color: var(--ink-2); line-height: 1.5; }

  /* --- Delivery lines ------------------------------------------------------ */
  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--s-4) var(--s-5);
    border-top: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
    padding-top: var(--s-4);
  }
  .line { display: flex; flex-direction: column; gap: 0.35em; }
  .line__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .line__note { font-size: 0.85rem; color: var(--ink-2); line-height: 1.5; }

  /* --- Tail ---------------------------------------------------------------- */
  .tail {
    border-top: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
    padding-block: clamp(3rem, 8vh, 5rem) var(--s-8);
  }
  .tail__h { font-size: clamp(1.8rem, 4vw, 2.6rem); max-width: 20ch; }
  .tail__p { color: var(--ink-2); max-width: 56ch; margin: var(--s-4) 0 var(--s-5); }
</style>

<script>
  import { mountFields } from '../lib/field/mount';
  import { initThesis } from '../lib/thesis';
  mountFields();
  const hero = document.querySelector<HTMLElement>('[data-thesis]');
  if (hero) initThesis(hero);
</script>
