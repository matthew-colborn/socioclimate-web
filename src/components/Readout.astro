---
/**
 * One floating labelled value, the pattern from brand/references/ref-2: small
 * dim label above, larger value below, no connector line.
 *
 * Real DOM text on purpose. It is the substance under the atmosphere, so it has
 * to be selectable, translatable and readable by a screen reader — never
 * painted into the canvas.
 *
 * Placement is derived from index and count rather than passed in, so a scene
 * with two readouts, three, or four each get a composition that still leaves
 * the focal object the centre.
 */
interface Props {
  label: string;
  value: string;
  note?: string;
  pending?: boolean;
  index: number;
  total: number;
  /** Stagger the entrance so they arrive in sequence, not as a block. */
  delay?: number;
}
const { label, value, note, pending = false, index, total, delay = 0 } = Astro.props;

//  2 → left, right
//  3 → top, left, right          (the ref-2 arrangement)
//  4 → two a side, stacked       (four across the top would crowd the object)
const LAYOUTS: Record<number, string[]> = {
  1: ['top'],
  2: ['left', 'right'],
  3: ['top', 'left', 'right'],
  4: ['left-up', 'right-up', 'left-down', 'right-down'],
};
const at = (LAYOUTS[total] ?? LAYOUTS[3])[index] ?? 'right';
---
<div
  class:list={['ro', `ro--${at}`, pending && 'ro--pending']}
  style={`--ro-delay:${delay}ms`}
>
  <span class="ro__label">{label}</span>
  <span class="ro__value">{value}</span>
  {note && <span class="ro__note">{note}</span>}
</div>

<style>
  .ro {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 0.28em;
    max-width: 16ch;
    pointer-events: none;
    /* Entrance: a short rise as the scene settles. Earns its place because the
       readouts are the evidence — arriving after the object gives the eye the
       object first and the numbers second. */
    opacity: 0;
    transform: translateY(10px);
    animation: ro-in 620ms var(--ease) var(--ro-delay, 0ms) forwards;
  }
  @keyframes ro-in {
    to { opacity: 1; transform: none; }
  }

  .ro--top       { left: 50%; transform: translate(-50%, 10px); top: 11%; text-align: center; align-items: center; }
  .ro--left      { left: max(var(--gutter), 11%); top: 32%; text-align: right; align-items: flex-end; }
  .ro--right     { right: max(var(--gutter), 11%); top: 32%; text-align: left;  align-items: flex-start; }
  .ro--left-up   { left: max(var(--gutter), 9%);  top: 18%; text-align: right; align-items: flex-end; }
  .ro--left-down { left: max(var(--gutter), 9%);  top: 42%; text-align: right; align-items: flex-end; }
  .ro--right-up  { right: max(var(--gutter), 9%); top: 18%; text-align: left;  align-items: flex-start; }
  .ro--right-down{ right: max(var(--gutter), 9%); top: 42%; text-align: left;  align-items: flex-start; }

  .ro--top { animation-name: ro-in-centred; }
  @keyframes ro-in-centred {
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  .ro__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
    opacity: 0.85;
  }
  .ro__value {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.28rem);
    font-weight: 400;
    letter-spacing: -0.008em;
    color: var(--paper);
    line-height: 1.2;
  }
  .ro__note {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--paper-dim);
    opacity: 0.8;
    line-height: 1.35;
  }

  /* An unfilled readout must be impossible to mistake for a real figure. */
  .ro--pending .ro__label,
  .ro--pending .ro__value,
  .ro--pending .ro__note { color: var(--paper-dim); }
  .ro--pending .ro__value { letter-spacing: 0.18em; opacity: 0.55; }
  .ro--pending {
    border: 1px dashed color-mix(in srgb, var(--paper-dim) 35%, transparent);
    border-radius: 2px;
    padding: 0.5em 0.7em;
  }

  @media (max-width: 60rem) {
    .ro { max-width: 12ch; }
    .ro--top { top: 6%; }
    .ro--left, .ro--right { top: 26%; }
    .ro--left-up, .ro--right-up { top: 12%; }
    .ro--left-down, .ro--right-down { top: 34%; }
    .ro--left, .ro--left-up, .ro--left-down { left: var(--gutter); }
    .ro--right, .ro--right-up, .ro--right-down { right: var(--gutter); }
    .ro__value { font-size: 0.9rem; }
    .ro__label { font-size: 0.6rem; }
    .ro__note { display: none; }
  }

  /* No entrance at all when motion is not wanted. */
  @media (prefers-reduced-motion: reduce) {
    .ro { opacity: 1; transform: none; animation: none; }
    .ro--top { transform: translateX(-50%); }
  }
</style>
