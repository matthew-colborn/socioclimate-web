---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  organization?: boolean;
  /** The hero sits under a transparent header; inner pages do not. */
  bleed?: boolean;
  /** Poster to preload — the LCP element on the hero. */
  preloadImage?: string;
}
const {
  title, description,
  organization = false, bleed = false, preloadImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), SITE.origin).href;
const ogImage = new URL('/og/socioclimate-og.png', SITE.origin).href;
// The compressed line, not the tagline: the full customer-facing sentence runs
// to 85 characters and a search result truncates it mid-clause.
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.compressed}` : `${title} — ${SITE.name}`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.origin,
  logo: ogImage,
  email: SITE.email,
  slogan: SITE.tagline,
  description:
    'SocioClimate is a data-leverage company. We partner with service businesses, ' +
    'find the valuable data already inside them, build the system that captures and ' +
    'makes sense of it, and point it at revenue.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San Diego',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href="/fonts/outfit-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" type="image/webp" fetchpriority="high" />
    )}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#020A21" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {organization && <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />}
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class={bleed ? '' : 'page'}>
      <slot />
    </main>
    <Footer />
    <script>
      import { initReveal } from '../lib/reveal';
      initReveal();
    </script>
  </body>
</html>

<style>
  .page { padding-top: clamp(6rem, 12vh, 9rem); }
</style>
