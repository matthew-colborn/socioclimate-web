---
/**
 * "What would make this wrong." It gets the same visual weight as the argument
 * it qualifies, because it is the credibility of the whole site rather than a
 * hedge tucked at the bottom.
 */
interface Props { title: string; kicker?: string }
const { title, kicker = 'Against the thesis' } = Astro.props;
---
<section class="cw" aria-labelledby="cw-h">
  <p class="cw__kicker">{kicker}</p>
  <h2 class="cw__title" id="cw-h">{title}</h2>
  <div class="cw__body"><slot /></div>
</section>

<style>
  .cw {
    margin: var(--s-7) 0 var(--s-6);
    padding: clamp(var(--s-4), 4vw, var(--s-6));
    background: var(--ink-black);
    border: var(--rule);
    border-left: 3px solid var(--cyan);
    border-radius: var(--radius);
  }
  .cw__kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan);
    margin: 0 0 var(--s-2);
  }
  .cw__title {
    font-size: var(--step-3);
    margin: 0 0 var(--s-4);
  }
  /* Inside the counterweight the h2 rule from .prose would double up. */
  .cw__body :global(h3) {
    margin-top: var(--s-5);
    font-size: var(--step-1);
  }
  .cw__body :global(h3 + p) { margin-top: var(--s-2); }
  .cw__body :global(> *:first-child) { margin-top: 0; }
</style>
