---
import CircuitFlame from './CircuitFlame.astro';
import Wordmark from './Wordmark.astro';
import { NAV } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-head">
  <div class="wrap site-head__inner">
    <a class="site-head__brand" href="/" aria-label="SocioClimate — home">
      <CircuitFlame size={18} glow={false} title="" />
      <Wordmark size="sm" />
    </a>
    <nav class="site-head__nav" aria-label="Primary">
      {NAV.map((i) => (
        <a href={i.href} aria-current={path === i.href ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>
  </div>
</header>
