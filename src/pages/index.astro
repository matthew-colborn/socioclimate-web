---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Field from '../components/Field.astro';
import Motif from '../components/Motif.astro';
import Hero from '../components/sc/Hero.astro';
import SectionHead from '../components/sc/SectionHead.astro';
import Register from '../components/sc/Register.astro';
import Ridge from '../components/sc/Ridge.astro';
import { SITE } from '../config/site';
import { lit } from '../lib/copy';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing src/content/pages/home.mdx');
const d = page.data;
const sec = (k: string) => {
  const s = d.sections.find((x) => x.key === k);
  if (!s) throw new Error(`home.mdx is missing the "${k}" section`);
  return s;
};
const beats = d.beats ?? [];
const [register, access, loop, method, close] = ['register', 'access', 'loop', 'method', 'close'].map(sec);
const sc01 = await getEntry('instances', 'deed-restricted');
---
<BaseLayout title={d.title} description={d.description} organization={true}>
  <Hero
    eyebrow={d.eyebrow}
    heading={d.heading}
    lead={d.lead}
    primary={d.primary}
    secondary={d.secondary}
    abyss={true}
    corners={{ tl: 'MMXXVI', tr: `${SITE.place} · ${sc01?.data.coordinates ?? ''}` }}
    ticks={['117°20′W', '117°15′W', '117°10′W', '117°05′W', '117°00′W']}
  >
    <div class="sc-portal" slot="visual">
      <canvas class="sc-plankton" data-plankton="sparkle" aria-hidden="true"></canvas>
      <Motif name="portal" />
    </div>
  </Hero>

  <Ridge />

  {/* The argument: the live rotator, three beats, its pause control intact. */}
  <section
    class="sc-section"
    data-thesis
    aria-roledescription="carousel"
    aria-label="The argument, in three beats"
  >
    <div class="wrap sc-argument">
      <div class="hero__copy">
        <div class="hero__stack" data-beat-stack>
          {beats.map((b, i) => (
            <article
              class:list={['beat', i === 0 && 'is-on']}
              data-beat={b.headline}
              role="group"
              aria-roledescription="slide"
              aria-label={`Beat ${i + 1} of ${beats.length}`}
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <p class="hero__eyebrow"><span class="hero__n">{b.n}</span><span>The argument</span></p>
              <h2 class="hero__h">{b.headline}</h2>
              <p class="hero__line">{b.line}</p>
              {b.readouts.length > 0 && (
                <ul class="beat__readouts">
                  {b.readouts.map((r) => (
                    <li class="readout">
                      <span class="readout__label">{r.label}</span>
                      <span class="beat__value">{r.value}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
        <div class="hero__act">
          <div class="beat-ctl">
            <button class="beat-ctl__pause" type="button" data-beat-pause aria-pressed="false">
              <span class="beat-ctl__glyph" aria-hidden="true"></span>
              <span data-beat-pause-label>Pause</span>
              <span class="visually-hidden"> the rotation</span>
            </button>
            <ul class="beat-ctl__dots">
              {beats.map((b, i) => (
                <li>
                  <button type="button" data-beat-goto={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={`Show beat ${i + 1} of ${beats.length}`}>
                    <span aria-hidden="true">{b.n}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="hero__field"><Field scene="flame" priority={false} /></div>
      <p class="visually-hidden" data-beat-live aria-live="off" aria-atomic="true"></p>
    </div>
  </section>

  <section class="sc-section" aria-labelledby="register-h">
    <div class="wrap">
      <SectionHead label={register.label} title={register.title} lead={register.lead} id="register-h" />
      <Register />
      <a class="sc-link" href="/databases">{register.link}<span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <Ridge flip />

  {/* Access: the larger pitch. A client of a data company sees what it sees. */}
  <section class="sc-section" aria-labelledby="access-h" data-caustic>
    <div class="wrap sc-access">
      <div>
        <SectionHead label={access.label} title={access.title} lead={access.lead} id="access-h" />
        <a class="sc-btn sc-btn--secondary" href="/access">{access.link}<span class="arrow" aria-hidden="true">↗</span></a>
      </div>
      <ul class="sc-access__list" data-reveal-stagger>
        {access.items.map((it) => (
          <li class="sc-liquid">
            {it.chip && <span class="sc-chip">{it.chip}</span>}
            <h3 class="sc-h4" set:html={lit(it.title)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sc-section" aria-labelledby="loop-h">
    <div class="wrap">
      <SectionHead label={loop.label} title={loop.title} id="loop-h" />
      <div class="sc-liquid-grid" data-reveal-stagger>
        {loop.items.map((it) => (
          <a class="sc-liquid" href={it.href}>
            {it.chip && <span class="sc-chip">{it.chip}</span>}
            <span class="n">{it.n}</span>
            <h3 class="sc-h4">{it.title}</h3>
            {it.body && <p>{it.body}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sc-section" aria-labelledby="method-h">
    <div class="wrap">
      <SectionHead label={method.label} title={method.title} id="method-h" />
      <div class="sc-weave-wrap" aria-hidden="true" data-reveal><Motif name="weave" /></div>
      <ol class="sc-steps" data-reveal-stagger>
        {method.items.map((it) => (
          <li>
            <h3 class="sc-h4">{it.title}</h3>
            {it.body && <p>{it.body}</p>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sc-section sc-close" aria-labelledby="close-h">
    <div class="wrap">
      <SectionHead title={close.title} id="close-h" />
      <a class="sc-btn sc-btn--secondary" href="/contact">{close.link}<span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero ---------------------------------------------------------------
     Two columns: the argument on the left, the mark on the right. The mark is
     one continuously running scene and never restarts between beats — what
     cycles is the text. */

  /* Every beat occupies the same grid cell, so the stack is as tall as the
     tallest one and swapping between them shifts nothing. A fixed min-height
     would be a magic number that goes stale the moment the copy changes. */
  .hero__stack { display: grid; }
  .beat {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 520ms var(--ease), transform 520ms var(--ease),
                visibility 0s linear 520ms;
  }
  .beat.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    /* The incoming beat overshoots slightly and settles rather than gliding to
       a stop. Weight is what stops a crossfade reading as a slideshow. */
    transition: opacity 520ms var(--ease), transform 620ms var(--ease-out-back),
                visibility 0s;
  }

  .hero__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 0.7em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-dim);
    margin: 0 0 var(--s-4);
  }
  .hero__n { color: var(--cyan); }
  .hero__h {
    /* Explicit, because this is a <p> rather than a heading. The h1/h2/h3 rule
       in base.css is what normally supplies the display face, and demoting the
       rotating headline to a paragraph — so the page has one stable h1 — quietly
       dropped it into the body face. This is the largest text on the site; it
       has to be Outfit. */
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.2rem);
    font-weight: 250;
    letter-spacing: -0.025em;
    line-height: 1.08;
    text-wrap: balance;
    margin: 0;
    max-width: 18ch;
  }
  .hero__line {
    font-size: clamp(0.95rem, 1.5vw, 1.08rem);
    color: var(--paper-dim);
    margin: var(--s-4) 0 0;
    max-width: 46ch;
  }

  .beat__readouts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: var(--s-3) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--teal-deep) 80%, transparent);
  }
  /* Not .readout__value: these are short qualitative claims rather than
     measurements, so they are set in the body face. Mono here would dress an
     assertion up as a reading. */
  .beat__value {
    font-size: 0.98rem;
    color: var(--paper);
    line-height: 1.3;
    max-width: 18ch;
  }

  /* --- Act: the fixed CTA and the rotation controls ------------------------ */
  .hero__act {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-5);
    margin-top: var(--s-6);
  }
  .beat-ctl { display: flex; align-items: center; gap: var(--s-4); }
  .beat-ctl__pause,
  .beat-ctl__dots button {
    background: none;
    border: 0;
    padding: 0.3em 0.1em;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--paper-dim);
    cursor: pointer;
    transition: color var(--dur-1) var(--ease);
  }
  .beat-ctl__pause { display: inline-flex; align-items: center; gap: 0.5em; }
  .beat-ctl__pause:hover,
  .beat-ctl__dots button:hover { color: var(--paper); }
  .beat-ctl__glyph {
    width: 7px; height: 9px;
    border-left: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }
  .beat-ctl__pause[aria-pressed='true'] .beat-ctl__glyph {
    border: 0;
    width: 0; height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 8px solid currentColor;
  }
  .beat-ctl__dots { display: flex; gap: var(--s-3); list-style: none; margin: 0; padding: 0; }
  .beat-ctl__dots button[aria-current='true'] { color: var(--cyan); }
  .beat-ctl__dots button[aria-current='true'] span {
    border-bottom: 1px solid var(--cyan);
    padding-bottom: 2px;
  }

  @media (max-width: 60rem) {
    .hero__h { font-size: clamp(1.6rem, 6vw, 2.2rem); max-width: 20ch; }
    .beat__readouts { gap: var(--s-4); }
    .beat__value { font-size: 0.9rem; }
  }

  /* No crossfade when motion is not wanted. The rotator does not auto-advance
     either, so this only affects the jump when a dot is pressed. */
  @media (prefers-reduced-motion: reduce) {
    .beat { transition: none; transform: none; }
    .beat.is-on { transition: none; }
  }

</style>
