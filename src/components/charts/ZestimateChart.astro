---
/**
 * The proof. Same model, same housing stock, same day — the only variable is
 * whether a price was published. Two firms' independently built models land on
 * the same two numbers, which suggests the error floor is a property of the
 * available observations rather than of either model.
 *
 * Values are hard-coded rather than passed in: they are a citation, not data.
 */
const W = 560;
const MAXPCT = 8;
const VALUE_GUTTER = 76;            // room for the big percentage at the bar end
const SCALE = (W - VALUE_GUTTER) / MAXPCT;
const px = (pct: number) => +(pct * SCALE).toFixed(1);

const groups = [
  {
    label: 'Listed for sale — a price is published',
    zillow: 1.8,
    redfin: 1.85,
    y: 32,
    key: false,
  },
  {
    label: 'Off market — no price is published',
    zillow: 7.2,
    redfin: 7.27,
    y: 170,
    key: true,
  },
];

const ticks = [0, 2, 4, 6, 8];
const AXIS_Y = 270;
---
<svg
  class="zc"
  viewBox={`0 0 ${W} 396`}
  role="img"
  aria-label="Bar chart of median valuation error in 2025. Homes listed for sale: Zestimate 1.8 percent, Redfin Estimate 1.85 percent. Off-market homes: Zestimate 7.2 percent, Redfin Estimate 7.27 percent. Same models, same housing stock, same day."
  preserveAspectRatio="xMidYMid meet"
>
  <!-- gridlines -->
  <g stroke="var(--teal-shadow)" stroke-width="1">
    {ticks.map((t) => <line x1={px(t)} y1="26" x2={px(t)} y2={AXIS_Y} opacity={t === 0 ? 0.9 : 0.3} />)}
  </g>

  {groups.map((g) => (
    <g>
      <text class="zc__label" x="0" y={g.y - 12}>{g.label}</text>

      <rect x="0" y={g.y} width={px(g.zillow)} height="40" rx="1"
            fill={g.key ? 'var(--cyan)' : 'var(--paper-dim)'} />
      <text class={`zc__value ${g.key ? 'zc__value--key' : ''}`}
            x={px(g.zillow) + 14} y={g.y + 31}>{g.zillow.toFixed(1)}%</text>

      <rect x="0" y={g.y + 46} width={px(g.redfin)} height="18" rx="1"
            fill="none" stroke={g.key ? 'var(--cyan)' : 'var(--paper-dim)'}
            stroke-width="1.5" stroke-dasharray="5 4" />
      <text class="zc__minor" x={px(g.redfin) + 12} y={g.y + 60}>{g.redfin.toFixed(2)}%</text>
    </g>
  ))}

  <!-- axis -->
  <line x1="0" y1={AXIS_Y} x2={px(MAXPCT)} y2={AXIS_Y} stroke="var(--teal-deep)" stroke-width="1.5" />
  <g class="zc__tick">
    {ticks.map((t) => <text x={px(t)} y={AXIS_Y + 26} text-anchor={t === 0 ? 'start' : 'middle'}>{t}%</text>)}
  </g>
  <text class="zc__axis-title" x="0" y={AXIS_Y + 54}>Median error, 2025</text>

  <!-- legend -->
  <g transform={`translate(0 ${AXIS_Y + 100})`}>
    <rect x="0" y="-13" width="26" height="16" fill="var(--paper-dim)" />
    <text class="zc__minor" x="36" y="0">Zestimate</text>
    <rect x="150" y="-13" width="26" height="16" fill="none"
          stroke="var(--paper-dim)" stroke-width="1.5" stroke-dasharray="5 4" />
    <text class="zc__minor" x="186" y="0">Redfin Estimate</text>
  </g>
</svg>

<style>
  .zc { width: 100%; height: auto; overflow: visible; }
  .zc__label {
    font-family: var(--font-mono);
    font-size: 19px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: var(--paper-dim);
  }
  .zc__value {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 600;
    fill: var(--paper);
  }
  .zc__value--key { fill: var(--cyan); }
  .zc__minor {
    font-family: var(--font-mono);
    font-size: 19px;
    fill: var(--paper-dim);
  }
  .zc__tick { font-family: var(--font-mono); font-size: 18px; fill: var(--paper-dim); }
  .zc__axis-title {
    font-family: var(--font-mono);
    font-size: 18px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--paper-dim);
  }
</style>
