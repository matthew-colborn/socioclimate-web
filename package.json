{
  "name": "socioclimate-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "socioclimate.io \u2014 the public website for SocioClimate.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "fonts": "node scripts/copy-fonts.mjs",
    "og": "node scripts/make-og.mjs",
    "contrast": "node scripts/contrast.mjs",
    "links": "node scripts/linkcheck.mjs",
    "deploy:staging": "astro build && firebase deploy --only hosting -P staging",
    "deploy:prod": "astro build && firebase deploy --only hosting -P prod",
    "trace": "node scripts/trace-mark.mjs",
    "shots": "node scripts/shots.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "budget": "node scripts/budget.mjs",
    "csp": "node scripts/csp-check.mjs",
    "verify": "npm run check && npm run build && npm run contrast && npm run links && npm run csp",
    "video": "node scripts/make-video.mjs",
    "video:check": "node scripts/video-check.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/sitemap": "^3.4.0",
    "astro": "^5.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/outfit": "^5.2.5",
    "chrome-launcher": "^1.2.1",
    "ffmpeg-static": "^5.3.0",
    "lighthouse": "^13.4.1",
    "puppeteer-core": "^25.8.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0"
  }
}
