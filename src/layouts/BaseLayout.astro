---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/deep-water.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config/site';
import Motif from '../components/Motif.astro';

interface Props {
  /** The full <title>, exactly as written in the page's MDX. */
  title: string;
  description: string;
  organization?: boolean;
  /** Poster to preload: the LCP element on a scene hero. */
  preloadImage?: string;
  /** Maximum reading of the depth gauge on this page, in metres. */
  depthMax?: number;
}
const { title, description, organization = false, preloadImage, depthMax = 4200 } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), SITE.origin).href;
const ogImage = new URL('/og/socioclimate-og.png', SITE.origin).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.origin,
  logo: ogImage,
  email: SITE.email,
  slogan: SITE.mission,
  description: SITE.tagline,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San Diego',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href="/fonts/outfit-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" type="image/webp" fetchpriority="high" />
    )}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#020A21" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* View transitions keep the document alive between routes, which is what
        lets the field carry on. The engine's clock is a session-wide origin, so
        a scene mounted on the next page picks up where the last one left off
        instead of restarting at zero. */}
    <ClientRouter />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {organization && <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />}
  </head>

  <body data-depth-max={depthMax}>
    {/* The wave surface from beneath the flame, behind the whole page. Fixed
        and aria-hidden: it is ground, not content, and it never affects
        layout, so it cannot move anything or contribute to CLS. */}
    <canvas class="backdrop" data-backdrop aria-hidden="true"></canvas>

    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>

    {/* The crystal colonnade closes every page, standing on its own water. */}
    <div class="wrap sc-colonnade-wrap" aria-hidden="true" data-reveal><Motif name="colonnade" /></div>
    <Footer />

    {/* Scroll read as depth. Desktop only; decorative. */}
    <div class="sc-depth" aria-hidden="true"><span data-depth>0000</span> M</div>

    <script>
      import { initBackdrop } from '../lib/field/backdrop';
      import { mountFields } from '../lib/field/mount';
      import { initProcess } from '../lib/process-controller';
      import { initThesis } from '../lib/thesis';
      import { initNav } from '../lib/nav';
      import { initMotion } from '../lib/motion';
      // With ClientRouter the document is never torn down, so everything that
      // binds to page content re-runs on astro:page-load. The backdrop is
      // document-level and starts once.
      const boot = (): void => {
        initNav();
        mountFields();
        const hero = document.querySelector<HTMLElement>('[data-thesis]');
        if (hero) initThesis(hero);
        initProcess();
        initMotion();
      };
      initBackdrop();
      document.addEventListener('astro:page-load', boot);
    </script>
  </body>
</html>

