---
import { getEntry } from 'astro:content';
import Field from '../Field.astro';

const page = await getEntry('pages', 'what-we-do');
if (!page) throw new Error('Missing src/content/pages/what-we-do.mdx');
const d = page.data;
---
<section id="01-what-we-do" class="site-section" tabindex="-1" aria-labelledby="s01-h">
  <span id="s01-h" class="visually-hidden">What we do</span>

  {/* The four moves used to be four expanded steps and three closing
      subsections. The whole thing is one paragraph now; the graphic beside it
      still carries the four states, so the sequence is told visually rather
      than at length. */}
  <div class="wrap process" data-process>
    <div class="process__stage">
      <div class="process__figure"><Field scene="process" variant="panel" /></div>
    </div>

    <div class="process__steps">
      <header class="page-head" data-reveal>
        <p class="eyebrow"><span class="page-head__n">{d.section}</span> What we do</p>
        <h2 class="section-h">{d.heading}</h2>
        <p class="what__p">{d.standfirst}</p>
      </header>
    </div>
  </div>

</section>

<style>
.page-head__n { color: var(--cyan); margin-right: 0.5em; }

  /* --- The process section -------------------------------------------------
     Two columns: one sticky canvas on the left, the four moves scrolling past
     on the right. The canvas is the only moving thing in this viewport, which
     is the whole reason it is one canvas and not four. */
  .process {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .process__stage {
    position: sticky;
    top: 8rem;
  }
  .process__figure :global(.field) {
    background: none;
    border: 0;
  }
  .process__figure :global(.field) { animation-delay: -11s; }
  .process__steps { min-width: 0; }
  .what__p {
    color: var(--paper-dim);
    font-size: var(--step-1);
    max-width: 52ch;
    margin: var(--s-4) 0 0;
  }


  @media (max-width: 60rem) {
    .process { grid-template-columns: 1fr; }
    /* On a phone the canvas sits under the header and stays there while the
       steps pass, which keeps the one-graphic reading without stealing the
       whole screen. */
    .process__stage { top: 4.5rem; margin-bottom: var(--s-5); }
    .process__figure { max-width: 15rem; margin-inline: auto; }
  }

  .move__name { font-size: clamp(1.5rem, 3.4vw, 2.2rem); }
  .move__body { margin-bottom: var(--s-4); }

  /* The result line is the one measured thing in each move, so it is set in
     mono and boxed off from the prose above it. */
  .move__result-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-dim);
  }

  .closing {
    border-top: 1px solid color-mix(in srgb, var(--teal-deep) 80%, transparent);
    padding-top: var(--s-5);
    padding-bottom: var(--s-7);
  }

</style>
