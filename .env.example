# Web3Forms. Create a free key at https://web3forms.com (250 submissions/month,
# no card). Copy this file to .env and fill in the key.
#
# PUBLIC_ is required: Astro only exposes PUBLIC_-prefixed variables to client
# code, and the diagnostic submits from the browser. A Web3Forms access key is
# designed to be public — it identifies the destination inbox, it does not
# authorise anything else.
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_FORM_KEY=
