---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Field from '../components/Field.astro';

const page = await getEntry('pages', 'what-we-do');
if (!page) throw new Error('Missing src/content/pages/what-we-do.mdx');
const { Content } = await render(page);
const d = page.data;

const moves = await Promise.all(
  (await getCollection('process'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (m) => ({ id: m.id, data: m.data, Body: (await render(m)).Content }))
);
---
<BaseLayout title={d.title} description={d.description}>
  <header class="page-head wrap">
    <p class="eyebrow"><span class="page-head__n">{d.section}</span> What we do</p>
    <h1>{d.heading}</h1>
    <p class="page-head__lede">{d.standfirst}</p>
  </header>

  {/* One canvas for the whole section. It sticks while the four moves scroll
      past it, so the same particle system carries all four steps rather than
      four separate graphics sitting beside four separate headings. */}
  <div class="wrap process" data-process>
    <div class="process__stage">
      <div class="process__figure"><Field scene="process" variant="panel" /></div>
    </div>

    <div class="process__steps">
      {moves.map((m) => (
        <article class="move" data-reveal data-step={m.data.step} id={m.id} tabindex="-1">
          <div class="move__head">
            <span class="move__n" aria-hidden="true">{m.data.step}</span>
            <h2 class="move__name">{m.data.name}</h2>
          </div>
          <p class="move__line">{m.data.line}</p>
          <div class="move__body prose"><m.Body /></div>
          <p class="move__result">
            <span class="move__result-label">What you have at the end</span>
            <span>{m.data.result}</span>
          </p>
        </article>
      ))}
    </div>
  </div>

  <section class="wrap closing" data-reveal aria-labelledby="closing-h">
    <p class="eyebrow" id="closing-h">The mechanism</p>
    <div class="prose"><Content /></div>
  </section>

  <section class="tail wrap" data-reveal>
    <p class="eyebrow">Next</p>
    <h2 class="tail__h">Four builds, labelled honestly.</h2>
    <p class="tail__p">What the businesses were, what was found inside them, and what it produced.</p>
    <a class="cta" href="/portfolio">See the work<span class="cta__arrow" aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<style>
  .page-head__n { color: var(--cyan); margin-right: 0.5em; }

  .move {
    border-top: 1px solid color-mix(in srgb, var(--teal-deep) 80%, transparent);
    padding-top: var(--s-5);
    /* Tall enough that each step owns the viewport as it passes, which is what
       lets scroll position drive the state cleanly. */
    margin-bottom: clamp(var(--s-7), 22vh, 12rem);
  }
  /* --- The process section -------------------------------------------------
     Two columns: one sticky canvas on the left, the four moves scrolling past
     on the right. The canvas is the only moving thing in this viewport, which
     is the whole reason it is one canvas and not four. */
  .process {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .process__stage {
    position: sticky;
    top: 8rem;
  }
  .process__figure :global(.field) {
    border: 1px solid color-mix(in srgb, var(--teal-shadow) 80%, transparent);
    border-radius: var(--radius);
    background: var(--ink-deep);
  }
  .process__steps { min-width: 0; }

  /* Every step is reachable and readable with no motion at all, so the anchor
     target gets scroll-margin and a focus ring rather than any reveal gating. */
  .move { scroll-margin-top: 7rem; }
  .move:focus { outline: none; }
  .move:focus-visible { outline: 2px solid var(--cyan-bright); outline-offset: 6px; }

  @media (max-width: 60rem) {
    .process { grid-template-columns: 1fr; }
    /* On a phone the canvas sits under the header and stays there while the
       steps pass, which keeps the one-graphic reading without stealing the
       whole screen. */
    .process__stage { top: 4.5rem; margin-bottom: var(--s-5); }
    .process__figure { max-width: 15rem; margin-inline: auto; }
  }

  .move__head { display: flex; align-items: baseline; gap: var(--s-3); margin-bottom: var(--s-3); }
  .move__n {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--cyan);
  }
  .move__name { font-size: clamp(1.5rem, 3.4vw, 2.2rem); }
  .move__line {
    font-size: var(--step-1);
    color: var(--paper);
    font-weight: 300;
    max-width: 46ch;
    margin-bottom: var(--s-4);
  }
  .move__body { margin-bottom: var(--s-4); }

  /* The result line is the one measured thing in each move, so it is set in
     mono and boxed off from the prose above it. */
  .move__result {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    max-width: 60ch;
    margin: 0;
    padding: var(--s-3) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--teal-shadow) 80%, transparent);
    font-size: 0.9rem;
    color: var(--paper);
  }
  .move__result-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-dim);
  }

  .closing {
    border-top: 1px solid color-mix(in srgb, var(--teal-deep) 80%, transparent);
    padding-top: var(--s-5);
    padding-bottom: var(--s-7);
  }

  .tail {
    border-top: 1px solid color-mix(in srgb, var(--teal-deep) 80%, transparent);
    padding-block: clamp(3rem, 8vh, 5rem) var(--s-8);
  }
  .tail__h { font-size: clamp(1.8rem, 4vw, 2.6rem); max-width: 20ch; }
  .tail__p { color: var(--paper-dim); max-width: 56ch; margin: var(--s-4) 0 var(--s-5); }
</style>

<script>
  import { mountFields } from '../lib/field/mount';
  import { initProcess } from '../lib/process-controller';
  mountFields();
  initProcess();
</script>
