---
/**
 * "Socio" in paper, "Climate" in cyan — the split from the horizontal lockup.
 * Size comes from a modifier class rather than a style attribute so the
 * Content-Security-Policy can refuse inline styles outright.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg';
  as?: 'span' | 'h1';
  class?: string;
}
const { size = 'md', as = 'span', class: klass = '' }: Props = Astro.props;
const Tag = as;
---
<Tag class={`wordmark wordmark--${size} ${klass}`}>
  <span class="wordmark__a">Socio</span><span class="wordmark__b">Climate</span>
</Tag>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1;
    white-space: nowrap;
    display: inline-block;
    margin: 0;
  }
  .wordmark--sm { font-size: var(--step-0); }
  .wordmark--md { font-size: var(--step-1); }
  .wordmark--lg { font-size: var(--step-4); }
  .wordmark__a { color: var(--ink); }
  .wordmark__b { color: var(--cyan); }
</style>
