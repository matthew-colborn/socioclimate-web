---
/**
 * Inline source marker. Every statistic on this site carries one, with an
 * as-of date. `href` is optional and unset today — see README, "Citations".
 */
interface Props {
  source: string;
  date: string;
  href?: string;
}
const { source, date, href } = Astro.props;
const label = `${source}, ${date}`;
---
<cite class="cite">
  {href ? <a href={href} rel="noreferrer">{label}</a> : label}
</cite>

<style>
  .cite {
    font-family: var(--font-mono);
    font-size: 0.78em;
    font-style: normal;
    color: var(--paper-dim);
    letter-spacing: 0.01em;
    white-space: normal;
  }
  .cite::before {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1px;
    vertical-align: 0.32em;
    margin: 0 0.4em 0 0.25em;
    background: var(--teal-deep);
  }
</style>
