---
import { getCollection, render } from 'astro:content';
import { MAILTO } from '../config/site';

interface Props {
  /** Which door this page ends on. */
  show?: 'partner' | 'acquire' | 'both';
  heading?: string;
}
const { show = 'both', heading = 'Two doors' } = Astro.props;

const all = (await getCollection('doors')).sort((a, b) => a.data.order - b.data.order);
const doors = show === 'both' ? all : all.filter((d) => d.data.key === show);
const rendered = await Promise.all(
  doors.map(async (d) => ({ data: d.data, Content: (await render(d)).Content }))
);
---
<section class="doors section section--black" aria-labelledby="doors-h">
  <div class="wrap">
    <p class="eyebrow" id="doors-h">{heading}</p>
    <div class={`doors__grid ${rendered.length === 1 ? 'doors__grid--one' : ''}`}>
      {rendered.map(({ data, Content }) => (
        <div class="door reveal">
          <p class="door__kicker">{data.kicker}</p>
          <h2 class="door__title">{data.title}</h2>
          <div class="door__body"><Content /></div>
          <a class="btn btn--solid" href={MAILTO[data.key]}>
            {data.cta}<span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .doors { border-top: var(--rule); }
  .doors__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--s-4), 5vw, var(--s-7));
  }
  .doors__grid--one { grid-template-columns: minmax(0, var(--measure)); }
  @media (max-width: 46rem) {
    .doors__grid { grid-template-columns: 1fr; }
  }
  .door + .door {
    border-left: var(--rule-faint);
    padding-left: clamp(var(--s-4), 5vw, var(--s-7));
  }
  @media (max-width: 46rem) {
    .door + .door {
      border-left: 0;
      padding-left: 0;
      border-top: var(--rule-faint);
      padding-top: var(--s-5);
    }
  }
  .door__kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-dim);
    margin: 0 0 var(--s-2);
  }
  .door__title { font-size: var(--step-2); margin-bottom: var(--s-3); }
  .door__body { color: var(--paper-dim); max-width: 46ch; }
  .door__body :global(p:last-child) { margin-bottom: var(--s-4); }
</style>
