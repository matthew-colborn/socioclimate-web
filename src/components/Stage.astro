---
import { getCollection } from 'astro:content';
import Readout from './Readout.astro';
import { clientName, type ClientKey } from '../config/site';

/**
 * The hero. Six scenes, one layout: statement, four pieces of proof, invitation.
 *
 * The layout never changes between scenes and that is the point — same
 * typography, same palette, same positions. Only the focal object, its motion
 * and the readouts differ, so it reads as one system breathing.
 *
 * Composition from brand/references/ref-2: radial glow behind a centred object,
 * readouts floating around it with no connector lines, headline bottom-left,
 * supporting copy and a single CTA bottom-right, everything else empty.
 */
const entries = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
const slides = entries.map((e) => ({
  ...e.data,
  display: clientName(e.data.clientKey as ClientKey, { cap: true }) ?? e.data.name,
}));
const n = slides.length;
---
<section
  class="stage"
  data-carousel
  aria-roledescription="carousel"
  aria-label="What we do, what we have built, and how to work with us"
>
  {slides.map((s, i) => (
    <article
      class:list={['slide', `slide--${s.kind}`, i === 0 && 'is-on']}
      data-slide
      data-scene={s.scene}
      data-title={s.display}
      role="group"
      aria-roledescription="slide"
      aria-label={`${i + 1} of ${n}: ${s.display}`}
      aria-hidden={i === 0 ? 'false' : 'true'}
    >
      <div class="slide__field">
        <img
          class="slide__poster"
          data-poster
          src={`/scenes/${s.scene}.webp`}
          alt=""
          aria-hidden="true"
          width="1440"
          height="900"
          fetchpriority={i === 0 ? 'high' : undefined}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
        <canvas class="slide__canvas" aria-hidden="true"></canvas>
      </div>

      <div class="slide__readouts">
        {s.readouts.map((r, k) => (
          <Readout
            label={r.label}
            value={r.value}
            note={r.note}
            pending={r.pending}
            index={k}
            total={s.readouts.length}
            delay={420 + k * 130}
          />
        ))}
      </div>

      <div class="slide__copy wrap">
        <div class="slide__left">
          <p class="slide__meta">
            <span class="slide__stage">
              {/* Work entries are labelled by section, not by stage. The honest
                  stage label still appears on /portfolio, where it is useful. */}
              {s.kind === 'work' ? 'Portfolio' : s.stage}
            </span>
            <span class="slide__name">{s.display}</span>
          </p>
          <h2 class="slide__headline">{s.headline}</h2>
        </div>
        <div class="slide__right">
          <p class="slide__line">{s.line}</p>
          <a class="cta" href={s.ctaHref} data-cta>
            {s.ctaLabel}<span class="cta__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </article>
  ))}

  <div class="stage__controls wrap">
    <button class="ctl ctl--pause" type="button" data-pause aria-pressed="false">
      <span class="ctl__glyph" aria-hidden="true"></span>
      <span data-pause-label>Pause</span>
      <span class="visually-hidden"> the scene rotation</span>
    </button>
    <ul class="stage__dots">
      {slides.map((s, i) => (
        <li>
          <button
            type="button"
            data-goto={i}
            aria-current={i === 0 ? 'true' : 'false'}
            aria-label={`Show scene ${i + 1} of ${n}: ${s.display}`}
          >
            <span aria-hidden="true">{String(i).padStart(2, '0')}</span>
          </button>
        </li>
      ))}
    </ul>
    <span class="stage__count" aria-hidden="true"><b data-count>00</b> / {String(n - 1).padStart(2, '0')}</span>
  </div>

  <p class="visually-hidden" data-live aria-live="off" aria-atomic="true"></p>
</section>

<script>
  import { initCarousel } from '../lib/carousel';
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) initCarousel(root);
</script>
